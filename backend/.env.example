# Copie para .env e TROQUE todas as senhas. O arquivo .env nunca vai para o Git.
ENVIRONMENT=development

# --- Postgres (usado pelo docker compose) ---
POSTGRES_PASSWORD=troque-superusuario
DB_OWNER_PASSWORD=troque-owner
DB_APP_PASSWORD=troque-app

# API: papel saas_app (sem superusuário, sem BYPASSRLS)
DATABASE_URL=postgresql+asyncpg://saas_app:troque-app@localhost:5432/saas_pilates
# Migrações: papel saas_owner (dono das tabelas)
MIGRATION_DATABASE_URL=postgresql+asyncpg://saas_owner:troque-owner@localhost:5432/saas_pilates

REDIS_URL=redis://localhost:6379/0

# Testes: SEMPRE no banco saas_pilates_test (o conftest recusa outro nome)
TEST_DATABASE_URL=postgresql+asyncpg://saas_app:troque-app@localhost:5432/saas_pilates_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://saas_owner:troque-owner@localhost:5432/saas_pilates_test
TEST_REDIS_URL=redis://localhost:6379/15

# --- WAHA (profile "whatsapp", usado a partir da fatia de WhatsApp) ---
WAHA_API_KEY=troque-waha
